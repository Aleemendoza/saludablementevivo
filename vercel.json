{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "functions": {
    "app/api/webhooks/mercadopago/route.ts": { "maxDuration": 30 },
    "app/api/cron/subscriptions/route.ts": { "maxDuration": 30 }
  },
  "crons": [
    { "path": "/api/cron/subscriptions", "schedule": "0 12 * * *" }
  ]
}
